import sys
import argparse
import pip._vendor.rich as rich
from pip._vendor.rich.console import Console
from pip._vendor.rich.panel import Panel
from pip._vendor.rich.text import Text
from pip._vendor.rich.box import ROUNDED

try:
    from prompt_toolkit.application import Application
    from prompt_toolkit.buffer import Buffer
    from prompt_toolkit.document import Document
    from prompt_toolkit.layout import Layout, HSplit, VSplit
    from prompt_toolkit.layout.containers import Window, ScrollOffsets
    from prompt_toolkit.layout.controls import FormattedTextControl, BufferControl
    from prompt_toolkit.layout.processors import Processor, Transformation, ConditionalProcessor
    from prompt_toolkit.key_binding import KeyBindings
    from prompt_toolkit.styles import Style
    from prompt_toolkit.filters import Condition
    from prompt_toolkit.formatted_text import ANSI
    from prompt_toolkit.widgets import Frame
    from prompt_toolkit.layout.dimension import Dimension
    from prompt_toolkit.layout.margins import ScrollbarMargin
    from prompt_toolkit.widgets import TextArea
except Exception:
    Application = None

def draw_ui(placeholder: str = 'Try "edit CardModal.jsx to..."'):
    console = Console()
    header_text = Text()
    header_text.append('🐋 ', style='bold blue')
    header_text.append('ORCA: ', style='bold')
    header_text.append('Orchestrating Agents', style='bold')
    header_panel = Panel(header_text, border_style='red', padding=(0, 1), box=ROUNDED)

    input_text = Text()
    input_text.append('> ', style='bold')
    if placeholder:
        input_text.append(placeholder, style='dim italic')
    input_panel = Panel(input_text, border_style='grey50', padding=(0, 1), box=ROUNDED)
    shortcuts_text = Text('Ctrl-H for help', style='grey50')

    console.print(header_panel)
    console.print()
    console.print(input_panel)
    console.print()
    console.print(shortcuts_text)


def debug_print(*args, **kwargs):
    # This will be replaced with a real debug_print function if --debug is used
    pass

def interactive_mode():
    if Application is None:
        Console().print('Interactive mode requires prompt_toolkit to be available.', style='bold red')
        return

    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        Console().print('Interactive mode requires a terminal (TTY). Falling back to the static demo.', style='bold red')
        return

    def configuration_stage() -> dict:
        config_items = [
            {'label': 'LLM', 'type': 'radio', 'options': ['GPT‑3.5', 'GPT‑4'], 'index': 0},
            {'label': 'Multi‑agent', 'type': 'toggle', 'value': False},
        ]
        selected = 0

        def build_config_fragments():
            fragments = []
            for i, item in enumerate(config_items):
                style_name = 'class:config.selected' if i == selected else 'class:config'
                if item['type'] == 'radio':
                    options = item.get('options', [])
                    index = item.get('index', 0)
                    if options and 0 <= index < len(options):
                        value = options[index]
                    elif options:
                        value = options[0]
                    else:
                        value = ''
                elif item['type'] == 'toggle':
                    value = 'Yes' if item.get('value', False) else 'No'
                else:
                    value = ''
                line = f"{item['label']}: "
                fragments.append((style_name, line))
                fragments.append((style_name, value))
                fragments.append(('', '\n'))
            return fragments

        config_control = FormattedTextControl(text=build_config_fragments)
        config_window = Window(content=config_control, wrap_lines=False, always_hide_cursor=True, style='class:config_window')

        header_text_cfg = Text()
        header_text_cfg.append('🐋 ', style='bold blue')
        header_text_cfg.append('ORCA: ', style='bold white')
        header_text_cfg.append('Orchestrating Agents', style='bold white')
        header_console = Console(record=True, width=80)
        header_console.print(Panel(header_text_cfg, border_style='red', padding=(0, 1), box=ROUNDED))
        rendered_header = header_console.export_text()
        header_control = FormattedTextControl(ANSI(rendered_header))
        header_window = Window(content=header_control, height=3, style='class:header_window')

        footer_control = FormattedTextControl([('class:config.footer', 'Use ↑/↓ to navigate, ←/→ to change values, Enter to continue, Esc to quit')])
        footer_window = Window(content=footer_control, height=1, dont_extend_height=True, style='class:footer_window')

        config_root = HSplit([header_window, config_window, footer_window], padding=1)
        kb_conf = KeyBindings()

        @kb_conf.add('up')
        def _up(event):
            nonlocal selected
            selected = (selected - 1) % len(config_items)
            event.app.invalidate()

        @kb_conf.add('down')
        def _down(event):
            nonlocal selected
            selected = (selected + 1) % len(config_items)
            event.app.invalidate()

        @kb_conf.add('left')
        def _left(event):
            if 0 <= selected < len(config_items):
                item = config_items[selected]
                if item['type'] == 'radio':
                    options = item.get('options', [])
                    if options:
                        idx = item.get('index', 0)
                        item['index'] = (idx - 1) % len(options)
                elif item['type'] == 'toggle':
                    item['value'] = not item.get('value', False)
                event.app.invalidate()

        @kb_conf.add('right')
        def _right(event):
            if 0 <= selected < len(config_items):
                item = config_items[selected]
                if item['type'] == 'radio':
                    options = item.get('options', [])
                    if options:
                        idx = item.get('index', 0)
                        item['index'] = (idx + 1) % len(options)
                elif item['type'] == 'toggle':
                    item['value'] = not item.get('value', False)
                event.app.invalidate()

        @kb_conf.add('enter')
        def _enter(event):
            event.app.exit(result=True)

        @kb_conf.add('escape')
        @kb_conf.add('c-c')
        def _abort(event):
            event.app.exit(result=False)

        config_style = Style.from_dict({
            'config_window': 'bg:#012d36 #c0c0c0',
            'config.selected': 'bold #e06c75',
            'config': '#c0c0c0',
            'footer_window': 'italic #5f7f87',
        })

        app = Application(layout=Layout(config_root), key_bindings=kb_conf, full_screen=True, style=config_style)
        result = app.run()
        if not result:
            return None
        cfg = {}
        for item in config_items:
            if item['type'] == 'radio':
                options = item.get('options', [])
                index = item.get('index', 0)
                if options and 0 <= index < len(options):
                    cfg[item['label']] = options[index]
                elif options:
                    cfg[item['label']] = options[0]
                else:
                    cfg[item['label']] = ''
            elif item['type'] == 'toggle':
                cfg[item['label']] = item.get('value', False)
            else:
                cfg[item['label']] = item.get('value', '')
        return cfg

    config = configuration_stage()
    if config is None:
        return

    llm_choice = config.get('LLM', 'GPT‑3.5')
    multi_agent = bool(config.get('Multi‑agent', False))
    temperature = config.get('Temperature', '0.7')

    import asyncio

    agent_names = ['agent1']
    if multi_agent:
        agent_names.append('agent2')
    agent_colors = {'agent1': '#56b6c2', 'agent2': '#c678dd'}
    current_agent_index = 0

    agent_running = False
    cancel_agent = False
    show_config_options = False
    selected_config_option = 0

    conversation_data = []
    style_to_rich = {
        'user-msg': 'bold #61afef',
        'system-msg': '#98c379',
        'tool-msg': 'bold #e5c07b',
        'hitl-msg': 'italic #e5c07b',
        'agent1-msg': agent_colors.get('agent1', '#56b6c2'),
        'agent2-msg': agent_colors.get('agent2', '#c678dd'),
    }

    def build_conversation_fragments():
        fragments = []
        for style_class, message in conversation_data:
            fragments.append((f'class:{style_class}', message))
            fragments.append(('', '\n'))
        return fragments

    class FollowAutoScrollControl(FormattedTextControl):
        """
        Custom control that scrolls to the bottom when follow is enabled. 
        The base class initializer accepts our cursor callback; this
        prevents FormattedTextControl from overwriting it with None.
        """
        def __init__(self, *args, **kwargs):
            self.follow = True
            super().__init__(*args, **kwargs, get_cursor_position=self._cursor_position)

        def _cursor_position(self):
            """Return a Point far down when following; otherwise, None."""
            from prompt_toolkit.data_structures import Point
            if not self.follow:
                return None
            # Use a very large row index to force the window to scroll
            return Point(0, 10**9)

        def is_focusable(self) -> bool:
            return True

        def reset_follow(self) -> None:
            self.follow = True

        def mouse_handler(self, mouse_event):
            from prompt_toolkit.mouse_events import MouseEventType
            if mouse_event.event_type == MouseEventType.SCROLL_UP:
                self.follow = False
            return super().mouse_handler(mouse_event)

    conversation_control = FollowAutoScrollControl(
        text=build_conversation_fragments,
        show_cursor=False,
    )
    conversation_window = Window(
        content=conversation_control,
        wrap_lines=True,
        height=Dimension(weight=1),
        right_margins=[ScrollbarMargin(display_arrows=True)],
        allow_scroll_beyond_bottom=False,
        scroll_offsets=ScrollOffsets(top=1, bottom=1),
        always_hide_cursor=True,
    )

    def refresh_conversation():
        conversation_control.text = build_conversation_fragments
        try:
            from prompt_toolkit.application.current import get_app
            app = get_app()
            app.invalidate()
        except Exception:
            pass

    input_buffer = Buffer()

    class PlaceholderProcessor(Processor):
        def __init__(self, placeholder: str, style: str = 'class:placeholder'):
            self.placeholder = placeholder
            self.style = style

        def apply_transformation(self, ti):
            doc = ti.document
            if doc.text:
                return ti
            fragments = ti.fragments.copy()
            fragments.append((self.style, self.placeholder))
            return Transformation(fragments)

    placeholder_processor = ConditionalProcessor(
        PlaceholderProcessor('Try "edit CardModal.jsx to..."', style='class:placeholder'),
        Condition(lambda: input_buffer.text == '')
    )

    prompt_control = FormattedTextControl([('class:prompt', '> ')])
    prompt_window = Window(width=2, content=prompt_control, style='class:prompt_window', dont_extend_height=True)
    input_control = BufferControl(buffer=input_buffer, input_processors=[placeholder_processor], focusable=True, focus_on_click=True)
    input_window = Window(content=input_control, style='class:input_window', dont_extend_height=True)
    input_row = VSplit([prompt_window, input_window], padding=0, style='class:input_row')
    input_frame = Frame(body=input_row, style='class:input_frame')

    header_text = Text()
    header_text.append('🐋 ', style='bold blue')
    header_text.append('ORCA: ', style='bold')
    header_text.append('Orchestrating Agents', style='bold')
    header_console = Console(record=True, width=80)
    header_console.print(Panel(header_text, border_style='red', padding=(0, 1), box=ROUNDED))
    rendered_header = header_console.export_text()
    header_control = FormattedTextControl(ANSI(rendered_header))
    header_window = Window(content=header_control, height=3, style='class:header_window', dont_extend_height=True)

    shortcuts_control = FormattedTextControl([('class:shortcuts', 'Ctrl-H for help')])
    shortcuts_window = Window(content=shortcuts_control, dont_extend_height=True, height=1, style='class:shortcuts_window')

    root_container = HSplit([header_window, conversation_window, input_frame, shortcuts_window], padding=1)
    layout = Layout(root_container, focused_element=input_window)

    style = Style.from_dict({
        '': 'bg:#012d36 #c0c0c0',
        'conversation_window': '',
        'user-msg': 'bold #61afef',
        'system-msg': '#98c379',
        'error-msg': '#e06c75',
        'agent1-msg': agent_colors.get('agent1', '#56b6c2'),
        'agent2-msg': agent_colors.get('agent2', '#c678dd'),
        'tool-msg': 'bold #e5c07b',
        'hitl-msg': 'italic #e5c07b',
        'input_disabled': 'bg:#013a48 #5f7f87',
        'prompt': '#e5c07b',
        'prompt_window': '',
        'input_window': 'bg:#013a48 #ffffff',
        'input_row': '',
        'input_frame': 'border:#5f5f87',
        'placeholder': 'italic #5f7f87',
        'header_window': '',
        'shortcuts': 'italic #5f7f87',
    })

    kb = KeyBindings()

    @kb.add('c-c')
    @kb.add('c-q')
    def _(event):
        event.app.exit()

    @kb.add('escape')
    def _(event):
        nonlocal cancel_agent
        if agent_running:
            cancel_agent = True

    @kb.add('up', filter=Condition(lambda: show_config_options))
    def _(event):
        nonlocal selected_config_option
        selected_config_option = (selected_config_option - 1) % 2
        update_config_bar()
        event.app.invalidate()

    @kb.add('down', filter=Condition(lambda: show_config_options))
    def _(event):
        nonlocal selected_config_option
        selected_config_option = (selected_config_option + 1) % 2
        update_config_bar()
        event.app.invalidate()

    @kb.add('left', filter=Condition(lambda: show_config_options))
    @kb.add('right', filter=Condition(lambda: show_config_options))
    def _(event):
        nonlocal llm_choice, multi_agent, agent_names, current_agent_index
        if selected_config_option == 0:
            llm_choice = 'GPT‑4' if llm_choice == 'GPT‑3.5' else 'GPT‑3.5'
        elif selected_config_option == 1:
            multi_agent = not multi_agent
            if multi_agent and 'agent2' not in agent_names:
                agent_names.append('agent2')
            elif not multi_agent and 'agent2' in agent_names:
                agent_names = ['agent1']
                current_agent_index = 0
        update_config_bar()
        event.app.invalidate()

    @kb.add('c-o')
    def _(event):
        nonlocal show_config_options, llm_choice, multi_agent, agent_names, current_agent_index
        nonlocal selected_config_option
        show_config_options = not show_config_options
        if show_config_options:
            selected_config_option = 0
            update_config_bar()
        else:
            shortcuts_control.text = [('class:shortcuts', 'Ctrl-H for help')]
        event.app.invalidate()

    @kb.add('c-g')
    def _(event):
        conversation_control.reset_follow()
        refresh_conversation()
        event.app.invalidate()

    async def wait_with_spinner(agent_name: str, duration: float):
        nonlocal cancel_agent
        debug_print("Starting spinner for agent:", agent_name)
        frames = ['⠋','⠙','⠹','⠸','⠼','⠴','⠦','⠧','⠇','⠏']
        spinner_index = len(conversation_data)
        debug_print("Initial spinner_index:", spinner_index)
        
        # Insert initial spinner message.
        try:
            conversation_data.append(('system-msg', f'🐋 ORCA - {agent_name}: processing… {frames[0]}'))
            debug_print(f"Added initial spinner message at index {spinner_index}")
            refresh_conversation()
            application.invalidate()

            start_time = asyncio.get_event_loop().time()
            frame = 1
        except Exception as e:
            debug_print(f"Error in spinner initialization: {e}")
            raise

        while asyncio.get_event_loop().time() - start_time < duration and not cancel_agent:
            try:
                await asyncio.sleep(0.2)
                # Clamp index if conversation_data length changed
                if spinner_index >= len(conversation_data):
                    debug_print(f"Spinner index {spinner_index} >= conversation data length {len(conversation_data)}, clamping")
                    spinner_index = len(conversation_data) - 1
                debug_print(f"Updating spinner at index {spinner_index} (frame {frame})")
                conversation_data[spinner_index] = (
                    'system-msg',
                    f'🐋 ORCA - {agent_name}: processing… {frames[frame % len(frames)]}'
                )
                frame += 1
                refresh_conversation()
                application.invalidate()
            except Exception as e:
                debug_print(f"Error in spinner update: {e}")
                raise

        # Safely remove spinner line
        if conversation_data:
            idx = min(spinner_index, len(conversation_data) - 1)
            conversation_data.pop(idx)
            refresh_conversation()
            application.invalidate()

    def update_config_bar():
        indicator_llm = '→ ' if selected_config_option == 0 else '  '
        indicator_multi = '→ ' if selected_config_option == 1 else '  '
        llm_str = f'{indicator_llm}LLM: {llm_choice}'
        multi_str = f'{indicator_multi}Multi‑agent: {"Yes" if multi_agent else "No"}'
        msg = f'{llm_str} | {multi_str}  ←/→ to toggle, ↑/↓ to move'
        shortcuts_control.text = [('class:shortcuts', msg)]

    @kb.add('c-h')
    def _(event):
        conversation_data.append((
            'system-msg',
            'Hotkeys:\n'
            '  Ctrl-C / Ctrl-Q: Exit\n'
            '  Ctrl-H: Show this help\n'
            '  Ctrl-O: Toggle config options\n'
            '  ↑/↓: Select option when config bar visible\n'
            '  ←/→: Toggle selected option\n'
            '  Esc: Cancel current agent'
        ))
        refresh_conversation()
        event.app.invalidate()

    @kb.add('enter')
    async def _(event):
        nonlocal agent_running, cancel_agent, current_agent_index
        if agent_running:
            return
        user_text = input_buffer.text.strip()
        if not user_text:
            return
        conversation_data.append(('user-msg', f'👤 User: {user_text}'))
        input_buffer.document = Document(text='', cursor_position=0)
        refresh_conversation()
        event.app.invalidate()
        cancel_agent = False
        agent_running = True
        input_row.style = 'class:input_disabled'
        event.app.invalidate()

        async def agent_loop(command: str):
            nonlocal agent_running, cancel_agent, current_agent_index
            agent_name = agent_names[current_agent_index]
            agent_style = f'{agent_name}-msg'
            if multi_agent:
                current_agent_index = (current_agent_index + 1) % len(agent_names)
            conversation_data.append((agent_style, f'🐋 ORCA - {agent_name}: Hello, let me check that for you…'))
            refresh_conversation()
            event.app.invalidate()
            await wait_with_spinner(agent_name, 1.0)
            if cancel_agent:
                conversation_data.append(('system-msg', 'Agent loop cancelled.'))
                agent_running = False
                input_row.style = 'class:input_row'
                refresh_conversation()
                event.app.invalidate()
                return
            conversation_data.append(('tool-msg', f'🐋 ORCA - {agent_name} - 🛠️ Tool call: processing {command}'))
            refresh_conversation()
            event.app.invalidate()
            await wait_with_spinner(agent_name, 1.0)
            if cancel_agent:
                conversation_data.append(('system-msg', 'Agent loop cancelled.'))
                agent_running = False
                input_row.style = 'class:input_row'
                refresh_conversation()
                event.app.invalidate()
                return
            conversation_data.append((agent_style, f'🐋 ORCA - {agent_name}: Results found'))
            refresh_conversation()
            event.app.invalidate()
            await wait_with_spinner(agent_name, 1.0)
            if cancel_agent:
                conversation_data.append(('system-msg', 'Agent loop cancelled.'))
                agent_running = False
                input_row.style = 'class:input_row'
                refresh_conversation()
                event.app.invalidate()
                return
            conversation_data.append((agent_style, f'🐋 ORCA - {agent_name}: Here are the details you requested.'))
            agent_running = False
            input_row.style = 'class:input_row'
            refresh_conversation()
            event.app.invalidate()

        event.app.create_background_task(agent_loop(user_text))

    @kb.add('backspace')
    def _(event):
        buffer = input_buffer
        if buffer.document.cursor_position > 0:
            buffer.delete_before_cursor(count=1)
            event.app.invalidate()

    @kb.add('delete')
    def _(event):
        buffer = input_buffer
        if buffer.document.cursor_position < len(buffer.text):
            buffer.delete(count=1)
            event.app.invalidate()

    application = Application(
        layout=layout,
        key_bindings=kb,
        full_screen=True,
        style=style,
        mouse_support=True
    )

    application.run()

def main():
    parser = argparse.ArgumentParser(description="Claude Code demo UI")
    parser.add_argument("--interactive", action="store_true", help="Run the interactive terminal UI instead of the static demo")
    parser.add_argument("--debug", action="store_true", help="Enable debug output")
    args = parser.parse_args()
    if args.interactive:
        try:
            if args.debug:
                import sys
                def debug_print(*args, **kwargs):
                    print("[DEBUG]", *args, file=sys.stderr, **kwargs)
                sys.excepthook = lambda t, v, tb: debug_print(f"Exception in {t.__name__}: {v}")
            else:
                debug_print = lambda *a, **k: None
            interactive_mode()
            draw_ui()
        except Exception as e:
            Console().print(f"[bold red]Interactive mode error:[/] {e}")
            if args.debug:
                import traceback
                traceback.print_exc()
            draw_ui()
    else:
        draw_ui()

if __name__ == "__main__":
    main()
